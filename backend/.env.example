PORT=8787
ALLOWED_ORIGIN=*
LINK_TTL_MINUTES=1440

# mock | handy | plexo
PAYMENT_MODE=mock

# Needed only when PAYMENT_MODE=handy
HANDY_CREATE_URL=
HANDY_TOKEN=

# Needed only when PAYMENT_MODE=plexo
PLEXO_GATEWAY_URL=https://testing.plexo.com.uy:4043/SecurePaymentGateway.svc
PLEXO_CLIENT_NAME=
PLEXO_CERT_PASSWORD=
PLEXO_CERT_FINGERPRINT=
PLEXO_PFX_PATH=
PLEXO_PFX_BASE64=
PLEXO_REDIRECT_URL=
# Base URL del sitio estático (GitHub Pages o servidor local). Usado para payment-return / success / failed.
PLEXO_FRONTEND_BASE_URL=https://rominagrasso.github.io/SacramentoShop
# Prueba local (ej. python -m http.server 5500 en la raíz del repo):
# PLEXO_FRONTEND_BASE_URL=http://127.0.0.1:5500
# PLEXO_REDIRECT_URL=http://127.0.0.1:5500/Home/payment-return.html
# Alternativa: redirect vía API → PLEXO_REDIRECT_URL=http://localhost:8787/payment/return
# CommerceId en API Plexo (GetCommerceIssuers, AddIssuer body CommerceId). Handy: ej. 65264.
PLEXO_COMMERCE_ID=
# OptionalCommerceId en ExpressCheckout (Auth + Payment). Si vacío, se usa PLEXO_COMMERCE_ID. Handy: ej. 66059.
# PLEXO_OPTIONAL_COMMERCE_ID=66059

# Optional: datos de ejemplo tipo manual ExpressCheckout (ClientInformation)
# PLEXO_CHECKOUT_EMAIL=
# PLEXO_CHECKOUT_NAME=Sacramento Guest
# PLEXO_CHECKOUT_DOC=12345678
# PLEXO_LIMIT_ISSUERS=4,11,15
# Leave empty to omit LimitIssuers entirely: PLEXO_LIMIT_ISSUERS=
# Omit LimitIssuers on ExpressCheckout only (diagnostic — gateway may still enforce defaults).
# PLEXO_EXPRESS_OMIT_LIMIT_ISSUERS=1
# PaymentData.Installments: max cuotas en checkout Plexo (default 6 en código si no definís env). 1 = solo contado.
# PLEXO_EXPRESS_MAX_INSTALLMENTS=6

# Visa/Totalnet: device fingerprint CyberSource (manual Plexo). Sin prefijo, 3DS suele fallar en pruebas.
# PLEXO_CYBERSOURCE_ORG_ID=45ssiuz3
# PLEXO_CYBERSOURCE_SESSION_PREFIX=

# Set to 1 on Render temporarily to log Plexo Auth response shape (no secrets).
# PAYMENT_DEBUG_LOG=1

# Admin zona de pagos (login + listado /api/payments/admin/*)
# Generar un secreto largo aleatorio para ADMIN_JWT_SECRET en producción.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Opcional: duración del token en segundos (default 28800 = 8h)
# ADMIN_JWT_TTL_SEC=28800
